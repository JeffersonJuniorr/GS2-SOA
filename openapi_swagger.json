  "components": {
    "schemas": {
      "AlertSeverity": {
        "type": "string",
        "enum": [
          "INFO",
          "WARNING",
          "CRITICAL"
        ],
        "title": "AlertSeverity"
      },
      "CitizenAlertCreateDTO": {
        "properties": {
          "station_code": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "title": "Station Code",
            "examples": [
              "EST-SE-01"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 5,
            "title": "Title",
            "examples": [
              "Elevador PCD parado no acesso Norte"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10,
            "title": "Description",
            "examples": [
              "Passageiro cadeirante aguarda apoio próximo à catraca central."
            ]
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "ACESSIBILIDADE_PCD",
            "examples": [
              "ACESSIBILIDADE_PCD"
            ]
          },
          "severity": {
            "$ref": "#/components/schemas/AlertSeverity",
            "default": "CRITICAL"
          },
          "reported_by": {
            "type": "string",
            "title": "Reported By",
            "default": "CIDADAO_APP",
            "examples": [
              "CIDADAO_PCD_VERIFICADO"
            ]
          }
        },
        "type": "object",
        "required": [
          "station_code",
          "title",
          "description"
        ],
        "title": "CitizenAlertCreateDTO"
      },
      "CitizenAlertResponseDTO": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "station_id": {
            "type": "integer",
            "title": "Station Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "reported_by": {
            "type": "string",
            "title": "Reported By"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "station_id",
          "title",
          "description",
          "category",
          "severity",
          "reported_by",
          "is_active"
        ],
        "title": "CitizenAlertResponseDTO"
      },
      "CrowdingLevel": {
        "type": "string",
        "enum": [
          "BAIXA",
          "MODERADA",
          "ALTA",
          "SUPERLOTADO"
        ],
        "title": "CrowdingLevel"
      },
      "EquipmentResponseDTO": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "station_id": {
            "type": "integer",
            "title": "Station Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "equipment_type": {
            "$ref": "#/components/schemas/EquipmentType"
          },
          "location_description": {
            "type": "string",
            "title": "Location Description"
          },
          "status": {
            "$ref": "#/components/schemas/EquipmentStatus"
          },
          "last_maintenance_note": {
            "type": "string",
            "title": "Last Maintenance Note"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "station_id",
          "code",
          "name",
          "equipment_type",
          "location_description",
          "status",
          "last_maintenance_note"
        ],
        "title": "EquipmentResponseDTO"
      },
      "EquipmentStatus": {
        "type": "string",
        "enum": [
          "OPERANTE",
          "INOPERANTE",
          "MANUTENCAO"
        ],
        "title": "EquipmentStatus"
      },
      "EquipmentStatusUpdateDTO": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/EquipmentStatus",
            "description": "Novo estado operacional do equipamento (OPERANTE, INOPERANTE, MANUTENCAO).",
            "examples": [
              "INOPERANTE"
            ]
          },
          "last_maintenance_note": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "title": "Last Maintenance Note",
            "description": "Observação técnica sobre a ocorrência ou reparo.",
            "default": "Atualização via painel de manutenção / sensor IoT.",
            "examples": [
              "Falha elétrica na botoeira do elevador PCD."
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "EquipmentStatusUpdateDTO"
      },
      "EquipmentType": {
        "type": "string",
        "enum": [
          "ELEVADOR_PCD",
          "ESCADA_ROLANTE",
          "PLATAFORMA_ELEVATORIA",
          "PISO_TATIL_SONORO"
        ],
        "title": "EquipmentType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MLPredictionRequestDTO": {
        "properties": {
          "temp_max_c": {
            "type": "number",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Temp Max C",
            "default": 32.8,
            "examples": [
              33.5
            ]
          },
          "temp_min_c": {
            "type": "number",
            "maximum": 45.0,
            "minimum": -5.0,
            "title": "Temp Min C",
            "default": 21.0,
            "examples": [
              22.0
            ]
          },
          "umidade_media_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 10.0,
            "title": "Umidade Media Pct",
            "default": 65.0,
            "examples": [
              68.0
            ]
          },
          "precipitacao_total_mm": {
            "type": "number",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Precipitacao Total Mm",
            "default": 8.5,
            "examples": [
              12.4
            ]
          },
          "categoria_deslocai": {
            "type": "string",
            "title": "Categoria Deslocai",
            "description": "Opções: INFRA_ESTACAO_E_PONTO, SUPERLOTACAO_E_INTERVALO, ACESSIBILIDADE_PCD, OPERACAO_EMBARQUE, CIRCULACAO_E_VIAS, ATENDIMENTO_IDOSO, BILHETE_UNICO_E_TARIFA",
            "default": "INFRA_ESTACAO_E_PONTO",
            "examples": [
              "INFRA_ESTACAO_E_PONTO"
